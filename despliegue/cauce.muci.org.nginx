# nginx para cauce.muci.org — copiar a /etc/nginx/sites-available/cauce.muci.org
# y enlazar en sites-enabled.
#
# Es una web PÚBLICA (la usan los referentes del barrio desde el teléfono), sin
# login. El tope de carga por persona lo pone server.py (30 puntos por hora);
# acá solo va el tope general contra ráfagas.

limit_req_zone $binary_remote_addr zone=cauce_general:10m rate=20r/s;

server {
    listen 80;
    listen [::]:80;
    server_name cauce.muci.org;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name cauce.muci.org;

    ssl_certificate     /etc/letsencrypt/live/cauce.muci.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cauce.muci.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 8k;
    server_tokens off;

    access_log /var/log/nginx/cauce.access.log;
    error_log  /var/log/nginx/cauce.error.log;

    add_header X-Frame-Options           "DENY"                           always;
    add_header X-Content-Type-Options    "nosniff"                        always;
    add_header Referrer-Policy           "same-origin"                    always;
    add_header Strict-Transport-Security "max-age=300; includeSubDomains" always;
    add_header X-Robots-Tag              "noindex, nofollow, noarchive"   always;
    # Mapas: OpenStreetMap (calles) y Esri (satélite). La geolocalización del
    # botón "Mi ubicación" necesita HTTPS, que es lo que da este bloque.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://tile.openstreetmap.org https://server.arcgisonline.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;

    limit_req zone=cauce_general burst=50 nodelay;
    limit_req_status 429;

    location / {
        proxy_pass http://127.0.0.1:8101;
        proxy_http_version 1.1;
        proxy_set_header Host            $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 30s;
    }
}
